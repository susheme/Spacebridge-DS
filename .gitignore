# Заготовки, не подключённые к DS. Перечислены поимённо, а не маской:
# рабочие иконки лежат в Icons/<группа>/, и маска Icons/*.svg молча
# съедала бы будущие настоящие экспорты, свалённые в корень.
Icons/Type=beam-v2.svg
Icons/Type=beam.svg
Icons/Type=return-allocation.svg
Icons/Type=transponder.svg
Icons/Type=transport-stream.svg
Icons/Type=user-terminal-group.svg

# Дампы описаний из внешнего экспорта
descriptions.export.json
descriptions.export-RUS.json

